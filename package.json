{
  "name": "@lazyants/hetzner-mcp-server",
  "version": "4.0.1",
  "description": "MCP server for the Hetzner Cloud API — manage servers, networks, volumes, and more",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hetzner-mcp-server": "dist/index.js",
    "hetzner-mcp-servers": "dist/entry-servers.js",
    "hetzner-mcp-networking": "dist/entry-networking.js",
    "hetzner-mcp-load-balancers": "dist/entry-load-balancers.js",
    "hetzner-mcp-ips": "dist/entry-ips.js",
    "hetzner-mcp-storage": "dist/entry-storage.js",
    "hetzner-mcp-storage-boxes": "dist/entry-storage-boxes.js",
    "hetzner-mcp-config": "dist/entry-config.js",
    "hetzner-mcp-dns": "dist/entry-dns.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "check-versions": "node scripts/check-versions.mjs",
    "prepublishOnly": "node scripts/check-versions.mjs --require-unpublished && npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.png"
  ],
  "keywords": [
    "mcp",
    "hetzner",
    "cloud",
    "api",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazyants/hetzner-mcp-server.git"
  },
  "mcpName": "io.github.lazyants/hetzner",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "FSL-1.1-MIT",
  "overrides": {
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.12",
    "form-data": "^4.0.6",
    "hono": "^4.13.11",
    "qs": "^6.16.0",
    "ip-address": "^10.7.4",
    "body-parser": "^2.3.0",
    "proxy-addr": "^2.0.8",
    "follow-redirects": "^1.16.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
