{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lazyants/hetzner",
  "description": "MCP server for the Hetzner Cloud API — servers, networks, volumes, firewalls, and more.",
  "repository": {
    "url": "https://github.com/lazyants/hetzner-mcp-server",
    "source": "github"
  },
  "version": "3.0.1",
  "icon": {
    "src": "https://raw.githubusercontent.com/lazyants/hetzner-mcp-server/main/logo.png",
    "mimeType": "image/png",
    "sizes": ["400x400"]
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@lazyants/hetzner-mcp-server",
      "version": "3.0.1",
      "environmentVariables": [
        {
          "name": "HETZNER_API_TOKEN",
          "description": "Hetzner Cloud API token.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "HETZNER_STORAGE_API_TOKEN",
          "description": "Storage Box API token; falls back to HETZNER_API_TOKEN when omitted.",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
